{
  "name": "media-lookup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue --fix",
    "start": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "npm run serve"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-brands-svg-icons": "^6.2.1",
    "@fortawesome/free-regular-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/vue-fontawesome": "^3.0.2",
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "bootstrap": "^5.3.1",
    "concurrently": "^8.2.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "mysql2": "^3.6.1",
    "sequelize": "^6.33.0",
    "vue": "^3.2.13",
    "vue-router": "^4.2.5",
    "vue3-google-login": "^2.0.25"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "vite-plugin-eslint": "^1.8.1"
  },
  "overrides": {
    "browserslist": "^4.28.7",
    "qs": "^6.15.4",
    "uuid": "^11.1.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "ignorePatterns": [
      "dist/",
      "src/controllers/",
      "src/models/",
      "src/routes/",
      "src/config/"
    ],
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "description": "## Project setup ``` npm install ```",
  "main": "server.js",
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "rest",
    "api"
  ],
  "author": "dertl",
  "license": "ISC"
}
